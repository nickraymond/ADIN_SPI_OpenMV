@@ -69,8 +69,13 @@
 
 #define VRING_COUNT             2
 #define VRING_ALIGNMENT         32
-// Note the number of buffers must be a power of 2
-#define VRING_NUM_BUFFS         64
+// Note the number of buffers must be a power of 2.
+// S23 (ADIN bench): 16 x 1544 B buffers per direction (RPMSG_BUFFER_SIZE
+// in extmod.mk) -- one full 1514 B L2 frame or 1400 B camera chunk per
+// message. Pool: 2 x 32 x 1544 = 98,816 B of the 120,832 B buffer
+// region (OMV_OPENAMP_SIZE 128K). 16 slots measurably starved HD's
+// 55-chunk bursts (3.10 -> 2.50 fps); 32 restores in-flight depth.
+#define VRING_NUM_BUFFS         32
 
