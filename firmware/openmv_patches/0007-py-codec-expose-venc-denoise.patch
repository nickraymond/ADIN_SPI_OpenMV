+        { MP_QSTR_denoise, MP_ARG_INT | MP_ARG_KW_ONLY, {.u_int = 0 } },
     };
 
     // Parse args.
@@ -481,6 +488,11 @@ static mp_obj_t py_h264_encoder_make_new(const mp_obj_type_t *type, size_t n_arg
         mp_raise_msg(&mp_type_ValueError, MP_ERROR_TEXT("refresh_interval must be 0 to 300"));
     }
 
+    // noiseLow/noiseLevel are documented [1,30] in h264encapi.h.
+    if ((args[ARG_denoise].u_int < 0) || (args[ARG_denoise].u_int > 30)) {
+        mp_raise_msg(&mp_type_ValueError, MP_ERROR_TEXT("denoise must be 0 (off) to 30"));
+    }
+
     if (args[ARG_quality].u_int > 100) {
         mp_raise_msg(&mp_type_ValueError, MP_ERROR_TEXT("Invalid quality"));
     }
@@ -545,6 +557,18 @@ static mp_obj_t py_h264_encoder_make_new(const mp_obj_type_t *type, size_t n_arg
     // bitrate smooth for streaming.
     coding.gdrDuration = self->refresh_interval;
 
+    // The driver refuses noiseReductionEnable when the synthesised hardware
+    // has no denoise filter (H264EncApi.c:527 checks hwCfg.dnfSupport), so a
+    // board without it fails loudly at construction rather than silently
+    // encoding without denoise.
+    if (args[ARG_denoise].u_int > 0) {
+        coding.noiseReductionEnable = 1;
+        coding.noiseLevel = args[ARG_denoise].u_int;
+        coding.noiseLow = 5;  // driver default
+    } else {
+        coding.noiseReductionEnable = 0;
+    }
+
     if (self->quality >= 0) {
         // Constant-quality mode: quality [0..100] maps linearly to a fixed
         // QP [51..0], bitrate is ignored. Open the QP window fully (the
@@ -574,7 +598,13 @@ static mp_obj_t py_h264_encoder_make_new(const mp_obj_type_t *type, size_t n_arg
     preproc.rotation = H264ENC_ROTATE_0;
     preproc.colorConversion.type = H264ENC_RGBTOYUV_BT601;
 
-    py_h264_encoder_check(H264EncSetCodingCtrl(self->inst, &coding));
+    if (H264EncSetCodingCtrl(self->inst, &coding) != H264ENC_OK) {
+        if (args[ARG_denoise].u_int > 0) {
+            mp_raise_msg(&mp_type_OSError,
+                         MP_ERROR_TEXT("encoder rejected denoise= (this silicon reports no denoise filter)"));
+        }
+        mp_raise_msg(&mp_type_OSError, MP_ERROR_TEXT("H264EncSetCodingCtrl failed"));
+    }
     py_h264_encoder_check(H264EncSetRateCtrl(self->inst, &rate));
     py_h264_encoder_check(H264EncSetPreProcessing(self->inst, &preproc));
 
