     static const mp_arg_t allowed_args[] = {
         { MP_QSTR_width, MP_ARG_REQUIRED | MP_ARG_INT },
         { MP_QSTR_height, MP_ARG_REQUIRED | MP_ARG_INT },
@@ -448,6 +449,12 @@ static mp_obj_t py_h264_encoder_make_new(const mp_obj_type_t *type, size_t n_arg
         { MP_QSTR_quality, MP_ARG_INT | MP_ARG_KW_ONLY, {.u_int = -1 } },
         { MP_QSTR_keyframe_interval, MP_ARG_INT | MP_ARG_KW_ONLY, {.u_int = 30 } },
         { MP_QSTR_refresh_interval, MP_ARG_INT | MP_ARG_KW_ONLY, {.u_int = 0 } },
+        // VC8000 in-loop Wiener denoiser. 0 = off (upstream behaviour,
+        // unchanged); 1..30 = noiseLevel. Sensor noise is uncorrelated
+        // frame to frame, so at a fine QP it is what P-frames actually
+        // spend their bits on; denoising before the coding loop is the
